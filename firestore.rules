rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDocPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function isAdmin() {
      return signedIn()
        && exists(userDocPath(request.auth.uid))
        && get(userDocPath(request.auth.uid)).data.role == 'admin'
        && get(userDocPath(request.auth.uid)).data.active != false;
    }

    function validServiceArea(area) {
      return area in ['Jakarta', 'Tangerang', 'Serpong', 'Depok', 'Bekasi', 'Bogor'];
    }

    function validOrderItem(item) {
      return item is map
        && item.keys().hasOnly(['productId', 'qty'])
        && item.keys().hasAll(['productId', 'qty'])
        && item.productId is string
        && item.productId.size() >= 1
        && item.productId.size() <= 150
        && item.productId.matches('^[A-Za-z0-9_-]+$')
        && item.qty is int
        && item.qty >= 1
        && item.qty <= 500;
    }

    // Firestore Rules cannot loop; validate each possible position explicitly.
    // A cart may contain up to 10 different menu types in a single public request.
    function validItemAt(items, index) {
      return items.size() <= index || validOrderItem(items[index]);
    }

    function validOrderItems(items) {
      return items is list
        && items.size() >= 1
        && items.size() <= 10
        && validItemAt(items, 0)
        && validItemAt(items, 1)
        && validItemAt(items, 2)
        && validItemAt(items, 3)
        && validItemAt(items, 4)
        && validItemAt(items, 5)
        && validItemAt(items, 6)
        && validItemAt(items, 7)
        && validItemAt(items, 8)
        && validItemAt(items, 9);
    }

    function validCustomer(customer) {
      return customer is map
        && customer.keys().hasOnly(['name', 'phone', 'deliveryDate', 'deliveryArea', 'address', 'notes'])
        && customer.keys().hasAll(['name', 'phone', 'deliveryDate', 'deliveryArea', 'address', 'notes'])
        && customer.name is string
        && customer.name.size() >= 2
        && customer.name.size() <= 100
        && customer.phone is string
        && customer.phone.size() >= 7
        && customer.phone.size() <= 30
        && customer.deliveryDate is string
        && customer.deliveryDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && validServiceArea(customer.deliveryArea)
        && customer.address is string
        && customer.address.size() >= 5
        && customer.address.size() <= 300
        && customer.notes is string
        && customer.notes.size() <= 500;
    }

    function validPublicOrder() {
      return request.resource.data.keys().hasOnly([
          'orderCode', 'customer', 'items', 'status', 'paymentStatus',
          'paymentReference', 'settlementStatus', 'stockReserved', 'stockRestored',
          'source', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'orderCode', 'customer', 'items', 'status', 'paymentStatus',
          'paymentReference', 'settlementStatus', 'stockReserved', 'stockRestored',
          'source', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.orderCode is string
        && request.resource.data.orderCode.size() >= 8
        && request.resource.data.orderCode.size() <= 40
        && validCustomer(request.resource.data.customer)
        && validOrderItems(request.resource.data.items)
        && request.resource.data.status == 'new'
        && request.resource.data.paymentStatus == 'unpaid'
        && request.resource.data.paymentReference == ''
        && request.resource.data.settlementStatus == 'pending'
        && request.resource.data.stockReserved == false
        && request.resource.data.stockRestored == false
        && request.resource.data.source == 'public-web'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    // Public catalog: only current, active selling prices and product descriptions.
    // Never put partner costPrice/bank details/margins in this collection.
    match /catalog/{productId} {
      allow read: if (resource.data.status == 'active') || isAdmin();
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Private product records hold costPrice, partnerId and internal margin inputs.
    match /products/{productId} {
      allow read, create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Safe fields for active partners may be shown publicly.
    match /partnerDirectory/{partnerId} {
      allow read: if (resource.data.status == 'active') || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Full partner records, including contact/bank data, are admin-only.
    match /partners/{partnerId} {
      allow read, create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Anyone may submit a partner application; only admins may view or review it.
    match /partnerApplications/{applicationId} {
      allow create: if request.resource.data.keys().hasOnly([
          'businessName', 'contactName', 'phone', 'area', 'capacity',
          'specialty', 'notes', 'status', 'createdAt', 'source'
        ])
        && request.resource.data.keys().hasAll([
          'businessName', 'contactName', 'phone', 'area', 'capacity',
          'specialty', 'notes', 'status', 'createdAt', 'source'
        ])
        && request.resource.data.businessName is string
        && request.resource.data.businessName.size() >= 2
        && request.resource.data.businessName.size() <= 100
        && request.resource.data.contactName is string
        && request.resource.data.contactName.size() <= 100
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 7
        && request.resource.data.phone.size() <= 30
        && request.resource.data.area is string
        && request.resource.data.area in ['Semua wilayah', 'Jakarta', 'Tangerang', 'Serpong', 'Depok', 'Bekasi', 'Bogor']
        && request.resource.data.capacity is string
        && request.resource.data.capacity.size() <= 80
        && request.resource.data.specialty is string
        && request.resource.data.specialty.size() <= 160
        && request.resource.data.notes is string
        && request.resource.data.notes.size() <= 500
        && request.resource.data.status == 'pending'
        && request.resource.data.source == 'website'
        && request.resource.data.createdAt == request.time;
      allow read, update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Spark-plan path: public checkout may create a price-free order request.
    // Only admins can read/update it. Prices/costs/stock are added atomically by an
    // authenticated admin transaction when the order is confirmed.
    match /orders/{orderId} {
      allow create: if validPublicOrder() || isAdmin();
      allow read, update: if isAdmin();
      allow delete: if false;
    }

    // Only admins may inspect and record payments to partners.
    match /settlements/{settlementId} {
      allow read, create, update: if isAdmin();
      allow delete: if false;
    }

    match /users/{userId} {
      allow read: if (signedIn() && request.auth.uid == userId) || isAdmin();
      // First admin is created manually in Firebase Console after creating the Auth user.
      allow create, update, delete: if isAdmin();
    }

    // This collection must contain public, non-secret settings only.
    match /publicSettings/{settingId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Default deny for every collection not listed above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
