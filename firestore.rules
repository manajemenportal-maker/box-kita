rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userDocPath(uid) { return /databases/$(database)/documents/users/$(uid); }
    function hasUserProfile() { return signedIn() && exists(userDocPath(request.auth.uid)); }
    function myProfile() { return get(userDocPath(request.auth.uid)).data; }
    function isAdmin() { return hasUserProfile() && myProfile().role == 'admin' && myProfile().active == true; }
    function isCustomer() { return hasUserProfile() && myProfile().role == 'customer' && myProfile().active == true; }
    function isPartner() { return hasUserProfile() && myProfile().role == 'partner' && myProfile().active == true && myProfile().partnerId is string; }
    function ownsPartner(partnerId) { return isPartner() && myProfile().partnerId == partnerId; }

    function validServiceArea(area) {
      return area in [
        'Jakarta', 'Jakarta Pusat', 'Jakarta Utara', 'Jakarta Barat', 'Jakarta Selatan', 'Jakarta Timur', 'Kepulauan Seribu',
        'Tangerang', 'Kota Tangerang', 'Kabupaten Tangerang', 'Tangerang Selatan', 'Serpong', 'BSD City', 'Ciputat', 'Pamulang', 'Pondok Aren',
        'Depok', 'Bekasi', 'Kota Bekasi', 'Kabupaten Bekasi', 'Bogor', 'Kota Bogor', 'Kabupaten Bogor'
      ];
    }
    function validOrderItem(item) {
      return item is map && item.keys().hasOnly(['productId','qty']) && item.keys().hasAll(['productId','qty'])
        && item.productId is string && item.productId.size() >= 1 && item.productId.size() <= 150
        && item.productId.matches('^[A-Za-z0-9_-]+$') && item.qty is int && item.qty >= 1 && item.qty <= 500;
    }
    function validItemAt(items, index) { return items.size() <= index || validOrderItem(items[index]); }
    function validOrderItems(items) {
      return items is list && items.size() >= 1 && items.size() <= 10
        && validItemAt(items,0) && validItemAt(items,1) && validItemAt(items,2) && validItemAt(items,3) && validItemAt(items,4)
        && validItemAt(items,5) && validItemAt(items,6) && validItemAt(items,7) && validItemAt(items,8) && validItemAt(items,9);
    }
    function validCustomer(customer) {
      return customer is map && customer.keys().hasOnly(['name','phone','deliveryDate','deliveryArea','address','notes'])
        && customer.keys().hasAll(['name','phone','deliveryDate','deliveryArea','address','notes'])
        && customer.name is string && customer.name.size() >= 2 && customer.name.size() <= 100
        && customer.phone is string && customer.phone.size() >= 7 && customer.phone.size() <= 30
        && customer.deliveryDate is string && customer.deliveryDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && validServiceArea(customer.deliveryArea) && customer.address is string && customer.address.size() >= 5 && customer.address.size() <= 300
        && customer.notes is string && customer.notes.size() <= 500;
    }
    function validPublicOrder() {
      return request.resource.data.keys().hasOnly(['orderCode','customer','customerUid','items','status','paymentStatus','paymentReference','settlementStatus','stockReserved','stockRestored','source','createdAt','updatedAt'])
        && request.resource.data.keys().hasAll(['orderCode','customer','items','status','paymentStatus','paymentReference','settlementStatus','stockReserved','stockRestored','source','createdAt','updatedAt'])
        && request.resource.data.orderCode is string && request.resource.data.orderCode.size() >= 8 && request.resource.data.orderCode.size() <= 40
        && validCustomer(request.resource.data.customer) && validOrderItems(request.resource.data.items)
        && (!request.resource.data.keys().hasAny(['customerUid']) || (isCustomer() && request.resource.data.customerUid == request.auth.uid))
        && request.resource.data.status == 'new' && request.resource.data.paymentStatus == 'unpaid' && request.resource.data.paymentReference == ''
        && request.resource.data.settlementStatus == 'pending' && request.resource.data.stockReserved == false && request.resource.data.stockRestored == false
        && request.resource.data.source == 'public-web' && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
    }
    function validSelfProfile(userId) {
      return signedIn() && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['role','active','displayName','email','phone','businessName','createdAt','updatedAt'])
        && request.resource.data.keys().hasAll(['role','active','displayName','email','phone','createdAt','updatedAt'])
        && request.resource.data.displayName is string && request.resource.data.displayName.size() >= 2 && request.resource.data.displayName.size() <= 100
        && request.resource.data.email is string && request.resource.data.email.size() <= 180
        && request.resource.data.phone is string && request.resource.data.phone.size() >= 7 && request.resource.data.phone.size() <= 30
        && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time
        && ((request.resource.data.role == 'customer' && request.resource.data.active == true && !request.resource.data.keys().hasAny(['businessName']))
          || (request.resource.data.role == 'partner_pending' && request.resource.data.active == false && request.resource.data.businessName is string && request.resource.data.businessName.size() >= 2 && request.resource.data.businessName.size() <= 100));
    }

    match /catalog/{productId} {
      allow read: if resource.data.status == 'active' || isAdmin() || (isPartner() && resource.data.partnerId == myProfile().partnerId);
      allow create, update, delete: if isAdmin();
    }
    // products contains internal costPrice/margin fields; only admins may read it.
    // Partners use the sanitized public catalog and their own sanitized order views.
    match /products/{productId} {
      allow read, create, update, delete: if isAdmin();
    }
    match /partnerDirectory/{partnerId} {
      allow read: if resource.data.status == 'active' || isAdmin();
      allow create, update, delete: if isAdmin();
    }
    match /partners/{partnerId} {
      allow read: if isAdmin() || ownsPartner(partnerId);
      allow create, update, delete: if isAdmin();
    }
    match /partnerApplications/{applicationId} {
      allow create: if request.resource.data.keys().hasOnly(['uid','businessName','contactName','phone','area','capacity','specialty','notes','status','createdAt','source'])
        && request.resource.data.keys().hasAll(['businessName','contactName','phone','area','capacity','specialty','notes','status','createdAt','source'])
        && request.resource.data.businessName is string && request.resource.data.businessName.size() >= 2 && request.resource.data.businessName.size() <= 100
        && request.resource.data.contactName is string && request.resource.data.contactName.size() >= 2 && request.resource.data.contactName.size() <= 100
        && request.resource.data.phone is string && request.resource.data.phone.size() >= 7 && request.resource.data.phone.size() <= 30
        && validServiceArea(request.resource.data.area) && request.resource.data.capacity is string && request.resource.data.capacity.size() <= 80
        && request.resource.data.specialty is string && request.resource.data.specialty.size() <= 160
        && request.resource.data.notes is string && request.resource.data.notes.size() <= 600
        && request.resource.data.status == 'pending' && request.resource.data.source == 'website' && request.resource.data.createdAt == request.time
        && (!request.resource.data.keys().hasAny(['uid']) || (signedIn() && request.resource.data.uid == request.auth.uid && exists(userDocPath(request.auth.uid)) && get(userDocPath(request.auth.uid)).data.role == 'partner_pending'));
      allow read, update, delete: if isAdmin();
    }
    // Main orders contain costPrice, partner payouts, and platform margins.
    // Only administrators can read/update the full order document.
    match /orders/{orderId} {
      allow create: if validPublicOrder() || isAdmin();
      allow read, update: if isAdmin();
      allow delete: if false;
    }

    // Customer-specific, sanitized order copies. A customer can read only their own subcollection.
    match /customerOrderViews/{customerUid}/orders/{orderId} {
      allow read: if isAdmin() || (isCustomer() && request.auth.uid == customerUid);
      // Admins may also seed a sanitized view for older orders during migration.
      allow create: if isAdmin() || (isCustomer() && request.auth.uid == customerUid
        && request.resource.data.keys().hasOnly(['orderId','orderCode','customerUid','customer','items','itemCount','total','status','paymentStatus','deliveryDate','createdAt','updatedAt'])
        && request.resource.data.keys().hasAll(['orderId','orderCode','customerUid','customer','items','itemCount','total','status','paymentStatus','deliveryDate','createdAt','updatedAt'])
        && request.resource.data.orderId == orderId
        && request.resource.data.customerUid == customerUid
        // The customer-created view must be written atomically with its own main order.
        && existsAfter(/databases/$(database)/documents/orders/$(orderId))
        && getAfter(/databases/$(database)/documents/orders/$(orderId)).data.customerUid == customerUid
        && getAfter(/databases/$(database)/documents/orders/$(orderId)).data.orderCode == request.resource.data.orderCode
        && request.resource.data.orderCode is string
        && request.resource.data.status == 'new'
        && request.resource.data.paymentStatus == 'unpaid'
        && request.resource.data.items is list && request.resource.data.items.size() >= 1 && request.resource.data.items.size() <= 10
        && request.resource.data.itemCount is int && request.resource.data.itemCount >= 1
        && request.resource.data.total is number && request.resource.data.total >= 0
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time);
      allow update, delete: if isAdmin();
    }

    // Partner-specific sanitized order copies. No customer retail total, cost fields, or margin is exposed.
    match /partnerOrderViews/{partnerId}/orders/{orderId} {
      allow read: if isAdmin() || ownsPartner(partnerId);
      allow create, update, delete: if isAdmin();
    }
    match /settlements/{settlementId} {
      allow read: if isAdmin() || ownsPartner(resource.data.partnerId);
      allow create, update: if isAdmin();
      allow delete: if false;
    }
    match /users/{userId} {
      allow read: if (signedIn() && request.auth.uid == userId) || isAdmin();
      allow create: if isAdmin() || validSelfProfile(userId);
      allow update: if isAdmin() || (signedIn() && request.auth.uid == userId && resource.data.role == 'customer'
        && request.resource.data.role == resource.data.role && request.resource.data.active == resource.data.active
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName','phone','updatedAt']));
      allow delete: if isAdmin();
    }
    // Private operational settings: bank account and admin-only configuration.
    match /adminSettings/{settingId} {
      allow read, create, update, delete: if isAdmin();
    }
    // Public-safe contact data only. Do not store private bank details in this collection.
    match /publicSettings/{settingId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /{document=**} { allow read, write: if false; }
  }
}
